# ─── Environment ─────────────────────────────
APP_NAME="Cohort Monitor"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# ─── Database ────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cohort_monitor
DB_USERNAME=root
DB_PASSWORD=

# ─── Charset ─────────────────────────────────
DB_CHARSET=utf8mb4

# ─── Session hardening (CM-SEC-002) ───────────
# Idle timeout in seconds (default 7200 = 2h).
# SESSION_LIFETIME=7200
# Absolute session cap regardless of activity (default 28800 = 8h).
# SESSION_ABSOLUTE_LIFETIME=28800
# Cookie SameSite: Lax|Strict|None (default Lax).
# SESSION_COOKIE_SAMESITE=Lax
# Cookie Secure flag: auto-detect from APP_URL; set explicitly to override.
# SESSION_COOKIE_SECURE=0
# Cookie HttpOnly (default 1).
# SESSION_COOKIE_HTTPONLY=1
